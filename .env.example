# Netlify Functions 환경변수 (이름만 기재 — 실제 값은 여기에 쓰지 않는다)
#
# 로컬 테스트: 이 파일을 복사해 ".env" 로 만들고 실제 값을 채운다 (.env 는 .gitignore 로 커밋 제외됨).
# 배포: Netlify 대시보드 > Site settings > Environment variables 에 동일한 이름으로 등록한다.
#
# SUPABASE_SERVICE_ROLE_KEY 는 관리자 권한 키이므로 브라우저/클라이언트 코드에 절대 노출하지 않는다.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
